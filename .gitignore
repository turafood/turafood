# ==========================================
# TURAFOOD — .gitignore raíz
# ==========================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Builds
.next/
out/
build/
dist/

# Secretos — NUNCA commitear
.env
.env.local
.env*.local
.env.production
.api-keys.env
.easypanel-token
*.pem
*.key

# Supabase local
.branches
.temp
supabase/.temp/

# Despliegue
.vercel/
.easypanel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema
.DS_Store
Thumbs.db
*.swp

# Coverage / tests
coverage/
.nyc_output/

# Editor
.idea/
*.iml

# Prototipos y mockups (referencia local, no versionar)
Tura Shop PWA - V2 - 13-08-2026/

# Capturas y referencias de diseño. Se conservan en disco, pero no
# tienen por qué viajar al servidor de despliegue.
newone/

# Historial del repo que turafood-cliente tenía por dentro.
# Se movió aquí para que sus archivos entren al repo padre; antes era
# un gitlink y la carpeta llegaba vacía a quien clonara.
_git-backup-turafood-cliente/

# Imágenes originales sin optimizar (67 MB).
# Las versiones servidas viven en cada public/images y pesan 1,8 MB.
# Se conservan localmente por si hay que regenerar a otra resolución.
_assets-originales/
*.tmp
