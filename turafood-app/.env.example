# ==========================================================
# TURAFOOD — app.turafood.com (negocios + repartidores)
#
# En EasyPanel estas variables van en DOS sitios:
#   · Environment  → para el contenedor en ejecución
#   · Build args   → porque las NEXT_PUBLIC_ se incrustan en el
#                    bundle DURANTE el build, no al arrancar.
# ==========================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ePayco → solo la llave PÚBLICA (customer id / public key).
# Se usa para el checkout de Biz Pro.
NEXT_PUBLIC_EPAYCO_KEY=
# "false" para cobrar de verdad; cualquier otro valor deja pruebas
NEXT_PUBLIC_EPAYCO_TEST=true

# Dominio público, para la URL de retorno de la pasarela
NEXT_PUBLIC_BASE_URL=https://app.turafood.com

# ----------------------------------------------------------
# NO poner aquí, nunca:
#   SUPABASE_SERVICE_ROLE_KEY  → salta todas las políticas RLS
#   EPAYCO_P_KEY / EPAYCO_PRIVATE_KEY → firman los pagos
#
# Esas tres viven en los secrets de Supabase (Edge Functions) y
# solo las ve el webhook, que es quien decide si un pago es válido.
# ----------------------------------------------------------
