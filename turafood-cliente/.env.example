# ==========================================================
# TURAFOOD — APP CLIENTE (usuario final)
# Copia este archivo a .env.local (desarrollo) o pega estas
# variables en EasyPanel → Environment (producción).
# ==========================================================

# ---- Supabase -------------------------------------------
# Supabase → Project Settings → API
# La "anon key" es pública por diseño: viaja al navegador y
# está protegida por las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- ePayco ---------------------------------------------
# SOLO la llave pública (PUBLIC_KEY del panel de ePayco).
# La P_KEY privada NO va aquí: vive en los secrets de la
# Edge Function, porque es la que valida la firma del pago.
NEXT_PUBLIC_EPAYCO_KEY=

# "false" = cobros reales. Cualquier otro valor = modo prueba de ePayco.
NEXT_PUBLIC_EPAYCO_TEST=false

# Dominio público de esta app. ePayco redirige aquí después
# del pago, así que en producción debe ser el dominio real.
NEXT_PUBLIC_BASE_URL=https://turafood.com


# ==========================================================
# NO PONER AQUÍ (importante)
# ==========================================================
# SUPABASE_SERVICE_ROLE_KEY
#   Esa llave salta TODAS las políticas RLS. En esta app no
#   se usa (no hay código de servidor que la necesite), y si
#   se filtra da acceso total a la base de datos.
#   Va únicamente en los secrets de Supabase, para el webhook.
#
# EPAYCO_P_KEY / EPAYCO_P_CUST_ID_CLIENTE
#   Igual: son del webhook, no de esta app.
#
# Recuerda que cualquier variable con prefijo NEXT_PUBLIC_
# queda visible en el navegador. Si un valor no puede ser
# público, no lleva ese prefijo — y probablemente no va en
# una app de Next.
